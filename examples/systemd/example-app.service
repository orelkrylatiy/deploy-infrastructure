[Unit]
Description=Example application managed by deploy-manager
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/var/www/projects/example-app/current
EnvironmentFile=-/var/www/projects/example-app/shared/.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
